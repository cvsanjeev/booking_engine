{
  "name": "booking-engine",
  "version": "1.0.0",
  "description": "Modern, multi-property booking engine for service apartments",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:setup": "cd packages/db && pnpm run generate && pnpm run migrate:dev && pnpm run seed",
    "db:reset": "cd packages/db && pnpm run reset",
    "db:studio": "cd packages/db && pnpm run studio",
    "db:migrate": "cd packages/db && pnpm run migrate:dev",
    "db:generate": "cd packages/db && pnpm run generate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "start": "turbo run start",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "prettier": "^3.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.1.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}